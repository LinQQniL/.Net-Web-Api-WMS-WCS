<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="NLog.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    以下文件排除编译：

    1) 旧实体：早期按"Users/Menus"表名和 int 主键设计的模型，与数据库实际结构
       （UserInfo/MenuInfo 等、string 主键）完全不符，已被 Entities\UserInfo.cs 等替代。
    2) 临时文件：为绕过"表不存在"问题而写的建表/拦截器逻辑，数据库已有真实表，
       这些代码不再需要，保留会产生编译与运行风险。
    3) 空壳/损坏文件：内容无效或编码损坏。
    4) GeneratedModels/GeneratedData：Scaffold 反向工程产物，当前仅作参考，
       实体已精选复制到 Entities，若一并编译会与 AppDbContext 重复注册模型。
  -->
  <ItemGroup>
    <!-- 旧实体（int 主键的 Users/Menus 方案，与真实库结构不符） -->
    <Compile Remove="Entities\User.cs" />
    <Compile Remove="Entities\Menu.cs" />
    <Compile Remove="Entities\Role.cs" />
    <Compile Remove="Entities\RoleMenu.cs" />
    <Compile Remove="Entities\MenuPower.cs" />
    <!-- 早期手写的 5 个实体，已统一迁到 WMS.DATA\Entities -->
    <Compile Remove="Entities\UserInfo.cs" />
    <Compile Remove="Entities\RoleInfo.cs" />
    <Compile Remove="Entities\MenuInfo.cs" />
    <Compile Remove="Entities\MenuPowerInfo.cs" />
    <Compile Remove="Entities\RoleMenuInfo.cs" />

    <!-- 旧的 Web 层上下文（已被 Data\DataContext.cs 替代） -->
    <Compile Remove="Data\AppDbContext.cs" />
    <Compile Remove="Data\WebDbContext.cs" />

    <!-- 临时建表逻辑 -->
    <Compile Remove="Data\DatabaseInitializer.cs" />
    <Compile Remove="Data\SchemaEnsureInterceptor.cs" />
    <Compile Remove="Migrations\**" />

    <!-- 旧控制器与空壳 DTO -->
    <Compile Remove="Controllers\AuthController.cs" />
    <Compile Remove="Controllers\AuthControllerApi.cs" />
    <Compile Remove="Controllers\MenuController.cs" />
    <Compile Remove="Models\ResultUserMenuDto.cs" />
    <Compile Remove="Models\MenusDto.cs" />
    <Compile Remove="Models\ApiResult.cs" />
    <Compile Remove="Models\MenuDto.cs" />
    <Compile Remove="Models\MenuManageDto.cs" />

    <!-- 旧版菜单服务：含无键实体 == 比较，运行时报 Cannot translate '=='，已由 Services\MenuService.cs 替代 -->
    <Compile Remove="Services\UserMenuService.cs" />

    <!-- 旧版上下文映射：HasNoKey 写法，数据库已补联合主键，由 WMS.DATA\WmsDb.cs 替代 -->
    <Compile Remove="WMS.DATA\WmsDbContext.cs" />

    <!-- Scaffold 产物：仅作参考，不参与编译（需要时可从 GeneratedModels 复制实体到 WMS.DATA） -->
    <Compile Remove="GeneratedModels\**" />
    <Compile Remove="GeneratedData\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NLog.Web.AspNetCore" Version="6.1.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.14.14" />
  </ItemGroup>

</Project>
